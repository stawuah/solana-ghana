# Neon Postgres. Use the pooled connection string.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=verify-full"

# Resend. https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Sender identity. Resend delivers from a verified domain only; the shared
# onboarding@resend.dev sender reaches the Resend account owner and nobody else.
RESEND_FROM="Solana Ghana <onboarding@resend.dev>"

# Set to "true" only once RESEND_FROM uses a domain verified in Resend.
# While false, organisers are notified but applicant confirmations are skipped.
RESEND_VERIFIED="false"

# Who receives submission notifications. Comma-separated for several people.
ORGANISER_EMAIL="you@example.com"

# Optional. Salts the stored IP hash; set to any long random string.
IP_HASH_SALT=""
